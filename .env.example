# NEXORA HUB — variáveis de ambiente (exemplo)
#
# Nenhum segredo real neste ficheiro. Copie para `.env` e preencha.
# Uma variável **vazia** equivale a ausente (ver apps/api/src/config/env.ts).

# Segredo da plataforma (obrigatório fora de teste). Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Persistência. Sem DATABASE_URL a API arranca em modo degradado (memória).
# DATABASE_URL=postgresql://nexora:nexora_dev@127.0.0.1:54330/nexora_hub
DATABASE_URL=

# Redis (presença/heartbeat e cache — fases futuras; só tipos nesta fase).
# REDIS_URL=redis://127.0.0.1:54390
REDIS_URL=

# Servidor HTTP da API.
HOST=127.0.0.1
PORT=3100

# Origens permitidas em CORS (a web em desenvolvimento).
CORS_ORIGIN=http://127.0.0.1:5173

# Base da API usada pelo cliente de desktop (omissão: http://127.0.0.1:3100).
# NEXORA_API_URL=http://127.0.0.1:3100

# Object storage (MinIO) — saves na nuvem são fase futura.
# MINIO_ENDPOINT=127.0.0.1:54900
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=nexora-hub-saves